server {
    listen 80;
    
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy OTel traces to avoid CORS
    location /v1/traces {
        proxy_pass ${OTEL_COLLECTOR_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Ensure CORS headers are stripped from upstream if present (optional, but good practice)
        # Nginx handles CORS for the browser interaction implicitly by being same-origin
    }
}
